[Unit]
Description=Mirai Web CAD MVP nightly PostgreSQL backup
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=kensan
Group=kensan
WorkingDirectory=/home/kensan/Projects/Mirai-DX-Project/Mirai-Web-CAD
EnvironmentFile=/home/kensan/.config/mirai-web-cad/mvp-backup.env
Environment=PG_BIN=/usr/lib/postgresql/16/bin
Environment=BACKUP_DIR=/var/backups/mirai-web-cad/mvp-postgres
Environment=RETENTION_DAYS=14
Environment=PATH=/home/kensan/.npm-global/bin:/home/kensan/.nvm/versions/node/v22.22.3/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/bash scripts/backup-local.sh

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/backups/mirai-web-cad/mvp-postgres
UMask=0077

[Install]
WantedBy=multi-user.target
