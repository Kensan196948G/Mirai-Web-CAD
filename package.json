{
  "name": "mirai-web-cad",
  "version": "0.1.0-mvp",
  "private": true,
  "type": "module",
  "description": "Mirai Web CAD MVP - browser-based agentic 2D CAD prototype",
  "scripts": {
    "dev": "node scripts/serve-local.mjs",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc -p tsconfig.check.json",
    "a11y": "node scripts/a11y-static.mjs",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "db:verify": "bash scripts/verify-database.sh",
    "build": "node scripts/build.mjs",
    "verify:fast": "npm run lint && npm run typecheck && npm run a11y && npm test && npm run build",
    "verify": "npm run verify:fast && npm run test:e2e"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "jose": "^6.2.10"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.126.0"
  }
}
